From cafff3c4b147ac9ee04bff1f336b796ae16f3a15 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E5=B0=8F=E6=98=8E?= <zhao@xiaoming.local>
Date: Tue, 2 Jun 2026 21:23:16 +0800
Subject: [PATCH] source: inject DIKW vault-write duty after every write_file
 to vault path
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds _inject_vault_duty() helper that checks every tool result — if the
tool was write_file and the path contains a 'vault' component, appends
a structured [DUTY] note to the tool result content.

The LLM sees this note on its very next turn, before generating any
assistant response. This is a hard-coded source-level enforcement (not
a SOUL.md rule or skill trigger), so it fires 100% of the time.

Modified: concurrent path (tool_executor.py:474) + sequential path
(tool_executor.py:893). Both fire after the tool result is appended to
messages but before the next LLM turn.
---
 agent/tool_executor.py | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/agent/tool_executor.py b/agent/tool_executor.py
index 438a63370..3ce1a5323 100644
--- a/agent/tool_executor.py
+++ b/agent/tool_executor.py
@@ -62,6 +62,31 @@ def _ra():
     return run_agent
 
 
+# ── DIKW vault-write duty injection ────────────────────────────────────
+# Source-level enforcement: after every write_file to a vault path, inject
+# an extraction reminder into the tool result so the LLM sees the duty on
+# its next turn. This is a hard-coded rule, not a SOUL.md reminder.
+_VAULT_DUTY_NOTE = (
+    "\n\n[DUTY: 你刚刚将完整文档写入 vault。根据 DIKW 模型，你必须在此后自动提炼 1-3 条核心方法论，"
+    "用事实库（fact_store）存入大脑。这是源码级强制规则，不依赖用户提醒。]"
+)
+
+
+def _inject_vault_duty(function_name: str, function_args: dict, messages: list) -> None:
+    """If the tool just wrote to a vault path, inject the extraction duty."""
+    if function_name != "write_file":
+        return
+    _path = function_args.get("path", "") or ""
+    if not _path:
+        return
+    _normalized = _path.replace(os.sep, "/")
+    if "vault" not in _normalized.split("/"):
+        return
+    current = messages[-1].get("content", "")
+    if isinstance(current, str):
+        messages[-1]["content"] = current + _VAULT_DUTY_NOTE
+
+
 def execute_tool_calls_concurrent(agent, assistant_message, messages: list, effective_task_id: str, api_call_count: int = 0) -> None:
     """Execute multiple tool calls concurrently using a thread pool.
 
@@ -446,6 +471,9 @@ def execute_tool_calls_concurrent(agent, assistant_message, messages: list, effe
         _tool_content = agent._tool_result_content_for_active_model(name, function_result)
         messages.append(make_tool_result_message(name, _tool_content, tc.id))
 
+        # ── DIKW vault-write duty injection ─────────────────────────
+        _inject_vault_duty(name, args, messages)
+
         # ── Per-tool /steer drain ───────────────────────────────────
         # Same as the sequential path: drain between each collected
         # result so the steer lands as early as possible.
@@ -862,6 +890,9 @@ def execute_tool_calls_sequential(agent, assistant_message, messages: list, effe
         _tool_content = agent._tool_result_content_for_active_model(function_name, function_result)
         messages.append(make_tool_result_message(function_name, _tool_content, tool_call.id))
 
+        # ── DIKW vault-write duty injection ─────────────────────────
+        _inject_vault_duty(function_name, function_args, messages)
+
         # ── Per-tool /steer drain ───────────────────────────────────
         # Drain pending steer BETWEEN individual tool calls so the
         # injection lands as soon as a tool finishes — not after the
