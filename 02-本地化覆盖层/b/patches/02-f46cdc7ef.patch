+def _adaptive_threshold_percent(
+    context_length: int,
+    max_threshold_tokens: int | None = None,
+) -> float:
+    """Calculate adaptive compression threshold based on context window size.
+
+    Uses a logarithmic curve so that:
+      -  64K context → ~0.70  (compress late, context is precious)
+      - 128K context → ~0.58
+      - 256K context → ~0.46
+      - 512K context → ~0.34
+      -   1M context → ~0.22  (compress early, plenty of room)
+
+    Clamped to [0.20, 0.75].  The caller should use ``min(config_value, adaptive)``
+    so the user's explicit threshold acts as a cap.
+
+    If *max_threshold_tokens* is provided (typically the compression model's
+    context length), the returned percentage is additionally capped so that
+    ``context_length * percentage <= max_threshold_tokens``.
+    """
+    ref = max(context_length, MINIMUM_CONTEXT_LENGTH)
+    adaptive = 0.70 - 0.12 * math.log2(ref / MINIMUM_CONTEXT_LENGTH)
+    adaptive = max(0.20, min(adaptive, 0.75))
+
+    if max_threshold_tokens is not None and context_length > 0:
+        max_pct = max_threshold_tokens / context_length
+        adaptive = min(adaptive, max_pct)
+
+    return adaptive
+
 
