+    def _update_bigrams_for_fact(self, fact_id: int, content: str) -> None:
+        """Extract and store character bigrams from raw content for fuzzy search."""
+        self._conn.execute(
+            "DELETE FROM fact_bigrams WHERE fact_id = ?", (fact_id,)
+        )
+        cjk_only = re.sub(r'[^一-鿿]', '', content)
+        bigrams = set()
+        for i in range(len(cjk_only) - 1):
+            bigrams.add(cjk_only[i:i+2])
+        if bigrams:
+            self._conn.executemany(
+                "INSERT OR IGNORE INTO fact_bigrams VALUES (?, ?)",
+                [(bg, fact_id) for bg in bigrams],
+            )
+        self._conn.commit()
+
+    def _bigram_search(
+        self,
+        query: str,
+        limit: int = 10,
+        category: str | None = None,
+        min_trust: float = 0.3,
+    ) -> list[dict]:
+        """Fallback search using character bigram Jaccard similarity.
+
+        Extracts CJK character bigrams from the query, looks them up in the
+        pre-computed fact_bigrams index, and scores facts by match ratio:
+        matched_bigrams / total_query_bigrams.
+
+        Only activates for queries with 2+ CJK characters.
+        """
+        cjk_only = re.sub(r'[^\u4e00-\u9fff]', '', query)
+        if len(cjk_only) < 2:
+            return []
+
+        q_bigrams: set[str] = set()
+        for i in range(len(cjk_only) - 1):
+            q_bigrams.add(cjk_only[i:i+2])
+
+        placeholders = ",".join("?" * len(q_bigrams))
+        params: list[str] = list(q_bigrams)
+
+        rows = self._conn.execute(
+            f"""
+            SELECT b.fact_id, b.bigram
+            FROM fact_bigrams b
+            JOIN facts f ON f.fact_id = b.fact_id
+            WHERE b.bigram IN ({placeholders})
+              AND f.trust_score >= ?
+            """,
+            params + [min_trust],
+        ).fetchall()
+
+        from collections import Counter
+        fact_matches: Counter = Counter()
