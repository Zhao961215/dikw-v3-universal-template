+    def _like_candidates(
+        self,
+        query: str,
+        category: str | None,
+        min_trust: float,
+        limit: int,
+    ) -> list[dict]:
+        """Fallback: LIKE OR + character-overlap rerank for Chinese queries.
+
+        FTS5 unicode61 tokenizer can't segment CJK characters, so full-text
+        MATCH returns empty for pure-Chinese queries. This method falls back
+        to SQL LIKE with OR conditions on each Chinese 2+ char word, then
+        reranks by character-overlap ratio + word-match count.
+
+        Returns same dict schema as _fts_candidates (fact fields + fts_rank).
+        """
+        import re
+
+        conn = self.store._conn
+
+        # Extract Chinese words (2+ chars) from query
+        words = re.findall(r"[\u4e00-\u9fff]{2,}", query)
+        if not words:
+            return []
+
+        # Build LIKE OR conditions
+        conditions = []
+        params: list = []
+        for w in words:
+            conditions.append("(f.content LIKE ? OR f.tags LIKE ?)")
+            params.extend([f"%{w}%", f"%{w}%"])
+
+        where_or = " OR ".join(conditions)
+        where_parts = [f"({where_or})"]
+
+        if category:
+            where_parts.append("f.category = ?")
+            params.append(category)
+        where_parts.append("f.trust_score >= ?")
+        params.append(min_trust)
+
+        where_sql = " AND ".join(where_parts)
+        params.append(limit)
+
+        sql = f"""
+            SELECT f.*
+            FROM facts f
+            WHERE {where_sql}
+            LIMIT ?
+        """
+
+        try:
+            rows = conn.execute(sql, params).fetchall()
+        except Exception:
+            return []
+
+        if not rows:
+            return []
+
+        # Character-overlap rerank (better than Jaccard for CJK)
+        q_chars = set(ch for ch in query if "\u4e00" <= ch <= "\u9fff")
+        q_words = set(words)
+
+        results = []
+        for row in rows:
+            fact = dict(row)
+            fact["fts_rank"] = 0.5  # neutral rank (not FTS5)
+
+            content = fact.get("content", "")
+            content_chars = set(ch for ch in content if "\u4e00" <= ch <= "\u9fff")
+            char_overlap = (len(q_chars & content_chars) / len(q_chars)) if q_chars else 0
+            word_matches = sum(1 for w in q_words if w in content)
+
+            fact["_char_overlap"] = char_overlap
+            fact["_word_matches"] = word_matches
+            results.append(fact)
+
+        # Sort by word-matches desc, then char-overlap desc
+        results.sort(key=lambda x: (x["_word_matches"], x["_char_overlap"]), reverse=True)
+        return results[:limit]
+
     def _fts_candidates(
         self,
         query: str,
